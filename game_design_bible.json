  "project": {
    "id": "oshi-no-tower-godot",
    "title": "Oshi no Tower Godot MVP",
    "genre": "deckbuilding roguelite playable demo",
    "engine": "Godot 4.6",
    "target_platform": "desktop",
    "production_scope": "godot_mvp_playable_demo",
    "main_scene": "res://scenes/main.tscn"
  },
  "creative_bible": {
    "premise": "Hololive 粉絲向推塔 roguelite，玩家用角色牌組處理直播事故、謎因敵人、資源取捨與 Boss 壓力。",
    "tone": "輕量、粉絲向、直播事故喜劇感，保留戰鬥與路線決策壓力。",
    "player_fantasy": "用推角特色牌組突破 16 floor 隨機塔，掌握 Boss 名稱與戰鬥 warning，把角色節奏打出來。",
    "core_loop": "選角 -> 生成 Chapter 1 16 floor random map -> 走節點取得卡牌/relic/事件代價 -> Boss 戰 -> Boss reward -> Chapter start event -> Chapter 2 random map -> Chapter 2 Boss reward 或 run summary",
    "forbidden_drift": [
      "新增第四位 playable",
      "未經 source-of-truth 直接新增章節 runtime",
      "把 deferred audio/art 假裝完成",
      "讓下游 skill 自行改寫角色定位",
      "將謎因事件描述成真實人物負面衝突"
    ]
  },
  "demo_priority": [
    "chapter_2_runtime_prototype",
    "build_variety_inside_single_act",
    "azki_laplus_marker_frequency",
    "three_character_full_run_qa",
